{
  "permissions": {
    "deny": [
      "Read(*.key)",
      "Read(*.pem)",
      "Read(*.p12)",
      "Read(*.pfx)",
      "Read(TA-*.json)",
      "Read(~/**/*.key)",
      "Read(~/**/*.pem)",
      "Read(~/**/*.p12)",
      "Read(~/**/*.pfx)",
      "Read(~/**/TA-*.json)",
      "Edit(*.key)",
      "Edit(*.pem)",
      "Edit(*.p12)",
      "Edit(*.pfx)",
      "Edit(TA-*.json)",
      "Edit(~/**/*.key)",
      "Edit(~/**/*.pem)",
      "Edit(~/**/*.p12)",
      "Edit(~/**/*.pfx)",
      "Edit(~/**/TA-*.json)",
      "Bash(npm publish *)",
      "Bash(yarn publish *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/scripts/agent/guard-bash.mjs\"",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/scripts/agent/stop-check.mjs\"",
            "timeout": 180
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "nucleo|interfaz|tester",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/scripts/agent/stop-check.mjs\"",
            "timeout": 300
          }
        ]
      }
    ]
  }
}
