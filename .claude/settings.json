{
  "permissions": {
    "allow": ["Bash(gh pr merge:*)", "Bash(gh workflow run:*)", "Bash(gh release create:*)"],
    "deny": [
      "Read(*.key)",
      "Read(*.pem)",
      "Read(*.p12)",
      "Read(*.pfx)",
      "Read(TA-*.json)",
      "Read(~/**/*.key)",
      "Read(~/**/*.pem)",
      "Read(~/**/*.p12)",
      "Read(~/**/*.pfx)",
      "Read(~/**/TA-*.json)",
      "Edit(*.key)",
      "Edit(*.pem)",
      "Edit(*.p12)",
      "Edit(*.pfx)",
      "Edit(TA-*.json)",
      "Edit(~/**/*.key)",
      "Edit(~/**/*.pem)",
      "Edit(~/**/*.p12)",
      "Edit(~/**/*.pfx)",
      "Edit(~/**/TA-*.json)",
      "Bash(npm publish *)",
      "Bash(yarn publish *)"
    ]
  }
}
