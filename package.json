{
  "name": "arcli",
  "version": "2.6.0",
  "description": "Facturá en ARCA (ex AFIP) desde tu terminal: con comandos, un asistente o tu IA.",
  "keywords": [
    "arca",
    "afip",
    "cli",
    "facturacion",
    "typescript",
    "factura-electronica",
    "argentina",
    "cae",
    "cuit",
    "automation"
  ],
  "homepage": "https://arcli.com.ar",
  "bugs": {
    "url": "https://github.com/LcsGrz/arcli/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LcsGrz/arcli.git"
  },
  "license": "MIT",
  "author": "LcsGrz",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": "./dist/cli/index.js"
  },
  "main": "./dist/cli/index.js",
  "bin": {
    "arcli": "dist/cli/index.js"
  },
  "files": [
    "assets",
    "dist",
    "LICENSE",
    "README.md",
    "CHANGELOG.md",
    "llms.txt"
  ],
  "scripts": {
    "build": "node ./scripts/clean-dist.mjs && tsc --project tsconfig.json && node ./scripts/fix-esm-extensions.mjs",
    "check:repo": "vitest run src/cli/__tests__/changelog-format.test.ts src/cli/__tests__/docs-sync.test.ts",
    "clean": "node ./scripts/clean-dist.mjs",
    "dev": "node --import tsx ./src/cli/index.ts",
    "lint": "yarn lint:eslint && yarn lint:prettier && yarn lint:guardrails",
    "lint:eslint": "eslint 'src/**/*.{js,jsx,ts,tsx,json}' 'site/scripts/**/*.mjs' 'site/src/**/*.ts' 'scripts/**/*.{ts,mts,mjs}'",
    "lint:eslint:fix": "eslint --fix 'src/**/*.{js,jsx,ts,tsx,json}' 'site/scripts/**/*.mjs' 'site/src/**/*.ts' 'scripts/**/*.{ts,mts,mjs}'",
    "lint:prettier": "prettier --check 'src/**/*.{js,jsx,ts,tsx,json,md}' 'docs/**/*.md' 'scripts/**/*.{ts,mts,mjs}' site/astro.config.mjs AGENTS.md README.md package.json",
    "lint:prettier:fix": "prettier --write 'src/**/*.{js,jsx,ts,tsx,json,md}' 'docs/**/*.md' 'scripts/**/*.{ts,mts,mjs}' site/astro.config.mjs AGENTS.md README.md package.json",
    "lint:guardrails": "knip --no-progress && knip --no-progress --production --include exports,types --tags=-internal && jscpd --silent && depcruise src --validate --output-type err && lockfile-lint --path yarn.lock --type yarn --allowed-hosts npm yarn --validate-https",
    "open-source:check": "yarn typecheck && yarn test:coverage && yarn build && publint --strict --pack npm && yarn test:e2e && yarn pack:check",
    "prepack": "yarn build",
    "pack:check": "node ./scripts/check-package.mjs",
    "prepare": "husky",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc --project tsconfig.typecheck.json",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "test:arca": "vitest run --config vitest.arca.config.ts",
    "docs:comprobantes": "tsx scripts/docs/generar-comprobantes.ts",
    "docs:readme-iconos": "tsx scripts/docs/generar-readme-iconos.ts",
    "contrato:actualizar": "node ./scripts/update-contract.mjs",
    "monotributo:tabla": "tsx scripts/monotributo/actualizar-tabla.ts"
  },
  "lint-staged": {
    "src/**/*.{ts,tsx}": [
      "tsc-files --noEmit"
    ],
    "src/**/*.{js,jsx,ts,tsx,json}": [
      "eslint --fix",
      "prettier --write"
    ],
    "{src/**/*.md,docs/**/*.md,scripts/**/*.{ts,mts,mjs},site/astro.config.mjs,AGENTS.md,README.md,package.json}": [
      "prettier --write"
    ],
    "src/**/*.{js,jsx,ts,tsx}": [
      "vitest related --silent --passWithNoTests --run"
    ]
  },
  "dependencies": {
    "@arcasdk/core": "2.0.2",
    "@inquirer/core": "12.1.1",
    "@inquirer/input": "5.2.1",
    "big.js": "7.0.1",
    "boxen": "9.0.0",
    "commander": "15.1.0",
    "conf": "16.0.0",
    "env-paths": "4.0.0",
    "node-forge": "^1.4.4",
    "ora": "10.0.0",
    "string-width": "^9.0.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@eslint/json": "2.1.1",
    "@types/big.js": "7.0.0",
    "@types/node": "22.20.7",
    "@types/node-forge": "^1.3.2",
    "@vitest/coverage-v8": "5.1.2",
    "dependency-cruiser": "18.9.0",
    "eslint": "10.16.0",
    "eslint-config-prettier": "10.1.9",
    "eslint-plugin-simple-import-sort": "14.0.0",
    "fast-check": "4.11.0",
    "husky": "9.1.7",
    "jscpd": "5.4.3",
    "knip": "6.49.0",
    "lint-staged": "17.6.2",
    "lockfile-lint": "5.1.1",
    "prettier": "3.10.1",
    "publint": "0.3.25",
    "tsc-files": "1.1.4",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.74.0",
    "vite": "8.4.0",
    "vitest": "5.1.2"
  },
  "engines": {
    "node": ">=22.22.1"
  },
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "yarn@1.22.22+sha256.c17d3797fb9a9115bf375e31bfd30058cac6bc9c3b8807a3d8cb2094794b51ca"
}
