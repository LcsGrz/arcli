---
/**
 * Encabezado: logo y version, las secciones del menu, el buscador, las estrellas de GitHub y el tema. Las secciones y
 * a donde lleva cada una salen de `generated/sidebar.json`, el mismo menu de la izquierda.
 */
import Search from 'virtual:starlight/components/Search';
import SiteTitle from 'virtual:starlight/components/SiteTitle';
import ThemeSelect from 'virtual:starlight/components/ThemeSelect';

import brand from '../generated/brand.json';
import sidebar from '../generated/sidebar.json';
import { REPO_URL, url } from '../lib/site';
import Chip from './Chip.astro';
import Icon from './Icon.astro';

type Item = { slug?: string; items?: Item[] };

const firstSlug = (items: Item[]): string | undefined => {
  for (const item of items) {
    const slug = item.slug ?? (item.items ? firstSlug(item.items) : undefined);
    if (slug) return slug;
  }
  return undefined;
};
const sections = sidebar.map((section) => {
  const slug = firstSlug(section.items as Item[]) ?? '';
  return { dir: slug.split('/')[0], href: url(`${slug}/`), label: section.label };
});
const current = Astro.locals.starlightRoute.id.split('/')[0];
---

<div class="header">
  <div class="brand">
    <SiteTitle />
    <Chip as="a" class="version" href={url('ayuda/novedades/')} title="Novedades de esta versión">v{brand.version}</Chip>
  </div>
  <nav class="sections" aria-label="Secciones">
    {sections.map((section) => <a href={section.href} aria-current={section.dir === current ? 'true' : undefined}>{section.label}</a>)}
  </nav>
  <div class="search print:hidden"><Search /></div>
  <div class="right print:hidden">
    {/* Sin `aria-label`: el lector de pantalla lee lo que se ve ("Star", las estrellas) más lo de `sr-only`, así quien usa
        el control por voz puede decir "Star" */}
    <a class="gh-star" href={REPO_URL}>
      <span class="gh-label">
        <Icon name="github" size="15" filled />
        Star<span class="sr-only">: dejá una estrella a ARCLI en GitHub</span>
      </span>
      {brand.stars !== null && <span class="gh-count"><Icon name="estrella" size="0.85rem" />{brand.stars}<span class="sr-only"> estrellas</span></span>}
    </a>
    <ThemeSelect />
  </div>
</div>

<style>
  .header {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    height: 100%;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    min-width: 0;
  }

  .version {
    padding: 0.1rem 0.5rem;
    font: 600 0.72rem / 1.5 var(--sl-font-system-mono);
    text-decoration: none;
  }

  .version:hover {
    color: var(--sl-color-white);
  }

  .sections {
    display: none;
    gap: 1.25rem;
  }

  .sections a {
    color: var(--sl-color-gray-2);
    font-size: var(--sl-text-sm);
    text-decoration: none;
    white-space: nowrap;
  }

  .sections a:hover,
  .sections a[aria-current] {
    color: var(--sl-color-white);
  }

  .sections a[aria-current] {
    font-weight: 600;
  }

  .search {
    flex: 1;
    display: flex;
    justify-content: flex-end;
  }

  .right {
    display: none;
    align-items: center;
    gap: 0.75rem;
  }

  .gh-star {
    display: flex;
    align-items: stretch;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.5rem;
    color: var(--sl-color-white);
    font-size: var(--sl-text-xs);
    font-weight: 600;
    text-decoration: none;
    overflow: hidden;
  }

  .gh-star > span {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.35rem 0.65rem;
  }

  .gh-count {
    border-inline-start: 1px solid var(--sl-color-gray-5);
  }

  .gh-count :global(.arcli-icon) {
    color: var(--arcli-estrella);
    fill: var(--arcli-estrella);
  }

  .gh-star:hover {
    border-color: var(--sl-color-gray-4);
  }

  @media (min-width: 50rem) {
    .right {
      display: flex;
    }
  }

  @media (min-width: 72rem) {
    .sections {
      display: flex;
    }

    .search {
      flex: 0 1 18rem;
      margin-inline-start: auto;
    }
  }
</style>
