---
/**
 * Encabezado: logo y version, las secciones del menu, el buscador, las estrellas de GitHub y el tema. Las secciones y
 * a donde lleva cada una salen de `generated/sidebar.json`, el mismo menu de la izquierda.
 */
import Search from 'virtual:starlight/components/Search';
import SiteTitle from 'virtual:starlight/components/SiteTitle';
import ThemeSelect from 'virtual:starlight/components/ThemeSelect';

import brand from '../generated/brand.json';
import sidebar from '../generated/sidebar.json';
import Icon from './Icon.astro';

type Item = { slug?: string; items?: Item[] };

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const firstSlug = (items: Item[]): string | undefined => {
  for (const item of items) {
    const slug = item.slug ?? (item.items ? firstSlug(item.items) : undefined);
    if (slug) return slug;
  }
  return undefined;
};
const sections = sidebar.map((section) => {
  const slug = firstSlug(section.items as Item[]) ?? '';
  return { dir: slug.split('/')[0], href: `${base}/${slug}/`, label: section.label };
});
const current = Astro.locals.starlightRoute.id.split('/')[0];
const repo = 'https://github.com/LcsGrz/arcli';
---

<div class="header">
  <div class="brand">
    <SiteTitle />
    <a class="version" href={`${base}/ayuda/novedades/`} title="Novedades de esta versión">v{brand.version}</a>
  </div>
  <nav class="sections" aria-label="Secciones">
    {sections.map((section) => <a href={section.href} aria-current={section.dir === current ? 'true' : undefined}>{section.label}</a>)}
  </nav>
  <div class="search print:hidden"><Search /></div>
  <div class="right print:hidden">
    <a class="gh-star" href={repo} aria-label={`Dejá una estrella a ARCLI en GitHub${brand.stars ? `: ${brand.stars} estrellas` : ''}`}>
      <span class="gh-label">
        <svg viewBox="0 0 24 24" width="15" height="15" fill="currentColor" aria-hidden="true"><path d="M12 .5a11.5 11.5 0 0 0-3.64 22.41c.58.1.79-.25.79-.56v-2c-3.2.7-3.88-1.37-3.88-1.37-.53-1.33-1.3-1.69-1.3-1.69-1.05-.72.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.71 1.26 3.37.96.1-.75.4-1.26.73-1.55-2.55-.29-5.24-1.28-5.24-5.69 0-1.26.45-2.29 1.19-3.09-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.17 1.18a11 11 0 0 1 5.77 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.8 1.19 1.83 1.19 3.09 0 4.42-2.69 5.39-5.26 5.68.41.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.56A11.5 11.5 0 0 0 12 .5Z" /></svg>
        Star
      </span>
      {brand.stars !== null && <span class="gh-count"><Icon name="estrella" size="0.85rem" />{brand.stars}</span>}
    </a>
    <ThemeSelect />
  </div>
</div>

<style>
  .header {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    height: 100%;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    min-width: 0;
  }

  .version {
    padding: 0.1rem 0.5rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 99px;
    color: var(--sl-color-gray-2);
    font: 600 0.72rem / 1.5 var(--sl-font-system-mono);
    text-decoration: none;
  }

  .version:hover {
    color: var(--sl-color-white);
  }

  .sections {
    display: none;
    gap: 1.25rem;
  }

  .sections a {
    color: var(--sl-color-gray-2);
    font-size: var(--sl-text-sm);
    text-decoration: none;
    white-space: nowrap;
  }

  .sections a:hover,
  .sections a[aria-current] {
    color: var(--sl-color-white);
  }

  .sections a[aria-current] {
    font-weight: 600;
  }

  .search {
    flex: 1;
    display: flex;
    justify-content: flex-end;
  }

  .right {
    display: none;
    align-items: center;
    gap: 0.75rem;
  }

  .gh-star {
    display: flex;
    align-items: stretch;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.5rem;
    color: var(--sl-color-white);
    font-size: var(--sl-text-xs);
    font-weight: 600;
    text-decoration: none;
    overflow: hidden;
  }

  .gh-star > span {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.35rem 0.65rem;
  }

  .gh-count {
    border-inline-start: 1px solid var(--sl-color-gray-5);
  }

  .gh-count :global(.arcli-icon) {
    color: var(--arcli-estrella);
    fill: var(--arcli-estrella);
  }

  .gh-star:hover {
    border-color: var(--sl-color-gray-4);
  }

  @media (min-width: 50rem) {
    .right {
      display: flex;
    }
  }

  @media (min-width: 72rem) {
    .sections {
      display: flex;
    }

    .search {
      flex: 0 1 18rem;
      margin-inline-start: auto;
    }
  }
</style>
