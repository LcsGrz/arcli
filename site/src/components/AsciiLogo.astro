---
/**
 * El logo de arcli como texto, igual que en la terminal (`src/ui/primitives/renderLogo.ts`): "AR" en celeste y "CLI"
 * en lavanda. Sale de `src/generated/brand.json`, que arma scripts/sync-docs.mjs desde el CLI.
 *
 * - `header` y `footer`: chico, en el encabezado y en el pie de cada página.
 * - `hero`: el de la portada, con la firma abajo; su tamaño y colores están en `styles/landing.css` (`.logo`).
 */
import brand from '../generated/brand.json';
import { escapeHtml } from '../lib/site';

interface Props {
  readonly variant: 'footer' | 'header' | 'hero';
}

const { variant } = Astro.props;
const width = Math.max(...brand.banner.map((line) => line.length));
const lines = brand.banner
  .map((line) => `<span class="ar">${escapeHtml(line.slice(0, brand.splitColumn))}</span><span class="cli">${escapeHtml(line.slice(brand.splitColumn))}</span>`)
  .join('\n');
---

{
  variant === 'hero' ? (
    <div class="logo" role="img" aria-label="ARCLI"><pre aria-hidden="true" set:html={`${lines}\n<span class="sign">${'-LcsGrz'.padStart(width)}</span>`} /></div>
  ) : (
    <pre class="logo-mini" data-size={variant} aria-hidden="true" set:html={lines} />
  )
}

<style>
  .logo-mini {
    margin: 0;
    padding: 0;
    border: 0;
    background: none;
    font-weight: 700;
  }

  .logo-mini[data-size='header'] {
    font-family: var(--sl-font-mono);
    font-size: 0.22rem;
    line-height: 1.12;
  }

  .logo-mini[data-size='footer'] {
    font-size: 0.3rem;
    line-height: 1.15;
  }

  .logo-mini :global(.ar) {
    color: var(--arcli-celeste);
  }

  .logo-mini :global(.cli) {
    color: var(--arcli-lavanda);
  }
</style>
