---
/**
 * El logo de arcli como texto, igual que en la terminal (`src/ui/primitives/renderLogo.ts`): "AR" en celeste y "CLI"
 * en el color del texto. Sale de `src/generated/brand.json`, que arma scripts/sync-docs.mjs desde el CLI.
 */
import brand from '../generated/brand.json';

interface Props {
  readonly signature?: boolean;
  readonly size?: 'hero' | 'small';
}

const { signature = true, size = 'hero' } = Astro.props;
const width = Math.max(...brand.banner.map((line) => line.length));
const lines = brand.banner.map((line) => [line.slice(0, brand.splitColumn), line.slice(brand.splitColumn)]);
---

<div class:list={['ascii-logo', size]} style={`--logo-cols: ${width}`} role="img" aria-label="ARCLI">
  <pre aria-hidden="true">{lines.map(([ar, cli]) => <span class="line"><span class="ar">{ar}</span><span class="cli">{cli}</span>{'\n'}</span>)}{signature && <span class="signature">{'-LcsGrz'.padStart(width)}</span>}</pre>
</div>

<style>
  .ascii-logo {
    container-type: inline-size;
    width: 100%;
    max-width: 46rem;
    margin-inline: auto;
  }

  .ascii-logo.small {
    max-width: 22rem;
  }

  pre {
    margin: 0;
    padding: 0;
    overflow: hidden;
    background: none;
    border: 0;
    font-family: var(--sl-font-system-mono);
    /* El dibujo ocupa todo el ancho disponible: el tamaño de letra sale del ancho, no al reves. */
    font-size: calc(100cqi / (var(--logo-cols) * 0.6));
    line-height: 1.18;
    font-weight: 600;
    white-space: pre;
  }

  .ar {
    color: var(--arcli-celeste);
  }

  .cli {
    color: var(--arcli-lavanda);
  }

  .signature {
    color: var(--sl-color-gray-3);
    font-weight: 400;
  }
</style>
