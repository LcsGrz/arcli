---
/** El índice de la derecha de Starlight y, abajo, la estrella de GitHub y el cafecito, como en la maqueta. */
import Default from '@astrojs/starlight/components/PageSidebar.astro';

import { CAFECITO_URL, REPO_URL } from '../lib/site';
---

<Default><slot /></Default>
{
  Astro.locals.starlightRoute.toc && (
    <div class="toc-star sl-hidden lg:sl-block">
      <p>¿ARCLI te ahorra tiempo?</p>
      <a href={REPO_URL}>
        <svg class="estrella" width="15" height="15" viewBox="0 0 24 24" aria-hidden="true"><path d="m12 2 3.1 6.3 6.9 1-5 4.9 1.2 6.8L12 17.8 5.8 21l1.2-6.8-5-4.9 6.9-1z" /></svg>
        Dejale una estrella
      </a>
      <a href={CAFECITO_URL}>
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="var(--arcli-celeste)" stroke-width="2" aria-hidden="true"><path d="M4 8h13v5a6 6 0 0 1-6 6h-1a6 6 0 0 1-6-6V8Z" /><path d="M17 10h1.5a2.5 2.5 0 0 1 0 5H17" /></svg>
        Invitame un cafecito
      </a>
    </div>
  )
}

<style>
  .toc-star {
    margin: 0.5rem var(--sl-sidebar-pad-x) 0;
    padding-top: 1rem;
    border-top: 1px solid var(--sl-color-gray-5);
    font-size: var(--sl-text-sm);
  }

  .toc-star p {
    margin: 0 0 0.6rem;
    color: var(--sl-color-gray-3);
  }

  .toc-star a {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    margin-top: 0.45rem;
    color: var(--sl-color-white);
    font-weight: 600;
    text-decoration: none;
  }

  .toc-star .estrella {
    fill: var(--arcli-estrella);
  }
</style>
