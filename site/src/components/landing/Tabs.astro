---
/**
 * Pestañas de la portada (demo, instalación y "¿Qué facturás?"): botones `role="tab"` con la primera elegida. Con el
 * teclado, como en cualquier tablist, las flechas, Inicio y Fin cambian de pestaña. Al elegir una, la lista avisa con
 * un evento `tabchange` (la clave en `detail`) y cada sección muestra lo suyo.
 *
 * Con `controls`, todas las pestañas manejan el mismo panel (ese id), que queda nombrado por la elegida.
 */
interface Props {
  readonly class: string;
  readonly controls?: string;
  /** El id de cada pestaña es `idPrefix` + su clave. */
  readonly idPrefix?: string;
  readonly items: readonly { readonly badge?: string; readonly key: string; readonly label: string }[];
  readonly label: string;
  /** La clase de cada botón. */
  readonly tabClass?: string;
}

const { class: className, controls, idPrefix, items, label, tabClass } = Astro.props;
---

<div class={className} role="tablist" aria-label={label} data-tabs>
  {
    items.map((item, index) => (
      <button
        class={tabClass}
        type="button"
        role="tab"
        id={idPrefix && `${idPrefix}${item.key}`}
        aria-selected={String(index === 0)}
        aria-controls={controls}
        tabindex={index === 0 ? undefined : -1}
        data-tab={item.key}
      >
        {item.label}{item.badge && <span class="badge">{item.badge}</span>}
      </button>
    ))
  }
</div>

<script>
  /** Las flechas, Inicio y Fin: el índice de la pestaña a la que se pasa. */
  const KEYS: Record<string, (index: number, count: number) => number> = {
    ArrowLeft: (index, count) => (index - 1 + count) % count,
    ArrowRight: (index, count) => (index + 1) % count,
    End: (_index, count) => count - 1,
    Home: () => 0,
  };

  for (const list of document.querySelectorAll<HTMLElement>('[data-tabs]')) {
    const tabs = [...list.querySelectorAll<HTMLElement>('[role="tab"]')];

    const select = (tab: HTMLElement) => {
      for (const other of tabs) {
        other.setAttribute('aria-selected', String(other === tab));
        other.tabIndex = other === tab ? 0 : -1;
      }
      const panel = tab.getAttribute('aria-controls');
      if (panel) document.getElementById(panel)?.setAttribute('aria-labelledby', tab.id);
      list.dispatchEvent(new CustomEvent('tabchange', { detail: tab.dataset.tab }));
    };

    for (const [index, tab] of tabs.entries()) {
      tab.addEventListener('click', () => select(tab));
      tab.addEventListener('keydown', (event) => {
        const move = KEYS[event.key];
        if (!move) return;
        event.preventDefault();
        const next = tabs[move(index, tabs.length)];
        select(next);
        next.focus();
      });
    }
  }
</script>
