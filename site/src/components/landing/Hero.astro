---
/** Arriba de todo: el logo, la versión, el título, la demo, la instalación y los botones para empezar. */
import brand from '../../generated/brand.json';
import { HERO, HERO_ACTIONS } from '../../data/landing';
import { url } from '../../lib/site';
import AsciiLogo from '../AsciiLogo.astro';
import Button from './Button.astro';
import Demo from './Demo.astro';
import Install from './Install.astro';
---

<section class="hero">
  <div class="wrap">
    <AsciiLogo variant="hero" />
    <a class="release" href={url(HERO.release.href)}><b>v{brand.version}</b> {HERO.release.text} <span aria-hidden="true">→</span></a>

    <h1>{HERO.title}</h1>
    <p class="lead">{HERO.lead}</p>
    <p class="tagline">{HERO.tagline}</p>

    <Demo />
    <Install />

    <div class="actions">
      <Button link={HERO_ACTIONS.ghost} variant="ghost" />
      <Button link={HERO_ACTIONS.primary} variant="primary" />
    </div>

    <p class="meta">
      <span><i class="dot" aria-hidden="true"></i>v{brand.version}</span>
      {HERO.meta.map((item) => <span>{item}</span>)}
    </p>
  </div>
</section>
