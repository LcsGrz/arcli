---
/**
 * La demo del hero: un GIF por pestaña (asistente, comandos, consultas) y, en "Con IA", el chat con una IA, que se
 * escribe mensaje por mensaje y vuelve a empezar. Los mensajes están en un `<template>` y el script los va copiando.
 */
import { CHAT, CHAT_HEAD, DEMOS } from '../../data/landing';
import { url } from '../../lib/site';
import Rich from './Rich.astro';
import Roll from './Roll.astro';
import Tabs from './Tabs.astro';

const [first] = DEMOS;
---

<div class="demo" id="demo">
  <Tabs class="demo-tabs" label="Demostraciones" items={DEMOS} idPrefix="demo-" controls="demo-panel" tabClass="tab" />
  <figure class="window" id="demo-panel" role="tabpanel" aria-labelledby={`demo-${first.key}`}>
    <img id="demo-img" src={url(first.src)} alt={first.alt} width="1100" height="780" fetchpriority="high" />
    <div class="chat" id="demo-chat" hidden aria-live="polite"></div>
    <template id="demo-chat-messages">
      <div class="chat-head"><span>{CHAT_HEAD.title} <b>{CHAT_HEAD.who}</b></span><span class="local">{CHAT_HEAD.local}</span></div>
      {
        CHAT.map((message) => (
          <div class:list={['msg', message.who]}><span class="who">{message.who === 'user' ? 'Vos' : <Roll />}</span>{message.text && <Rich text={message.text} />}{message.cmd && <pre><span class="k">$</span> {message.cmd}</pre>}{message.after && <p class="msg-text"><Rich text={message.after} /></p>}</div>
        ))
      }
    </template>
  </figure>
  <p class="demo-caption" id="demo-caption">{first.caption}</p>
</div>

<script>
  import { DEMOS } from '../../data/landing';
  import { url } from '../../lib/site';
  import { syncRolls } from './roll';

  const tabs = document.querySelector('.demo-tabs');
  const chat = document.getElementById('demo-chat');
  const messages = document.getElementById('demo-chat-messages') as HTMLTemplateElement | null;
  const image = document.getElementById('demo-img') as HTMLImageElement | null;
  const caption = document.getElementById('demo-caption');
  const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;
  let chatTimer: ReturnType<typeof setTimeout> | undefined;

  /**
   * El chat desde el principio: el encabezado y un mensaje cada 1,3 s (los tuyos) o 2,1 s (los de la IA); 5 s después
   * del último, vuelve a empezar. Con movimiento reducido se muestra entero una vez y queda quieto, sin timers.
   */
  function playChat() {
    if (!chat || !messages) return;
    clearTimeout(chatTimer);
    const [head, ...items] = [...messages.content.children];
    chat.replaceChildren(head.cloneNode(true));
    const show = (template: Element) => {
      const item = template.cloneNode(true) as HTMLElement;
      chat.append(item);
      syncRolls(item, false);
      return item;
    };
    if (reduceMotion) {
      items.forEach(show);
      return;
    }
    let step = 0;
    const next = () => {
      if (step >= items.length) {
        chatTimer = setTimeout(playChat, 5000);
        return;
      }
      const item = show(items[step++]);
      chatTimer = setTimeout(next, item.classList.contains('user') ? 1300 : 2100);
    };
    next();
  }

  tabs?.addEventListener('tabchange', (event) => {
    const demo = DEMOS.find((item) => item.key === (event as CustomEvent<string>).detail) ?? DEMOS[0];
    const isChat = !demo.src;
    if (image) image.hidden = isChat;
    if (chat) chat.hidden = !isChat;
    if (isChat) playChat();
    else {
      clearTimeout(chatTimer);
      if (image && demo.src) {
        image.src = url(demo.src);
        image.alt = demo.alt ?? '';
      }
    }
    if (caption) caption.textContent = demo.caption;
  });
</script>
