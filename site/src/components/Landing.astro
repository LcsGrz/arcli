---
/**
 * Portada del sitio, como quedó en la maqueta (DOCS-5): logo, demo, instalación y después ¿Qué facturás?, Para empezar,
 * Cómo es facturar, Formas de uso, Características, ¿Factura en línea o ARCLI?, Seguridad, preguntas y el cierre.
 *
 * Cada sección es un componente de `landing/` y sus textos y listas están en `data/landing.ts`. El CSS está en
 * `styles/landing.css`, todo dentro de `.arcli-landing` para no tocar las docs. El logo, la versión y el prompt de
 * instalación salen del CLI y del README (`brand.json`).
 *
 * Pendiente: la sección Comunidad, con comentarios reales y el permiso de cada autor (DOCS-4).
 */
import '../styles/landing.css';

import Compare from './landing/Compare.astro';
import Cta from './landing/Cta.astro';
import Faq from './landing/Faq.astro';
import Features from './landing/Features.astro';
import FirstSteps from './landing/FirstSteps.astro';
import Hero from './landing/Hero.astro';
import HowItWorks from './landing/HowItWorks.astro';
import Trust from './landing/Trust.astro';
import Vouchers from './landing/Vouchers.astro';
import Ways from './landing/Ways.astro';
---

<div class="arcli-landing not-content">
  <Hero />
  <div class="lbody">
    <Vouchers />
    <FirstSteps />
    <HowItWorks />
    <Ways />
    <Features />
    <Compare />
    <Trust />
  </div>
  <Faq />
  <Cta />
</div>

<script>
  import { startRolls } from './landing/roll';

  const root = document.querySelector<HTMLElement>('.arcli-landing');
  if (root) startRolls(root);
</script>
