---
/** El título de Starlight y, en los comprobantes, la familia arriba ("Monotributo"), con el color de su letra. */
import Default from '@astrojs/starlight/components/PageTitle.astro';

import { parseFamily } from '../lib/familia';
import { isHome } from '../lib/site';
import Chip from './Chip.astro';

const family = parseFamily(Astro.locals.starlightRoute.entry.data.familia);
---

{family && <Chip as="p" class="familia" color={family.color}>{family.name}</Chip>}
{!isHome(Astro.locals.starlightRoute) && <Default><slot /></Default>}

<style>
  .familia {
    width: fit-content;
    margin: 1rem 0 -0.25rem;
    padding: 0.15rem 0.6rem;
    font: 600 0.72rem / 1.5 var(--sl-font-system-mono);
  }
</style>
